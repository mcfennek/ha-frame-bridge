  "components": {
    "schemas": {
      "ArtModeBody": {
        "properties": {
          "on": {
            "type": "boolean",
            "title": "On"
          }
        },
        "type": "object",
        "required": [
          "on"
        ],
        "title": "ArtModeBody"
      },
      "Body_upload_image_api_images_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File",
            "description": "JPG- oder PNG-Datei"
          },
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "description": "fit (Einpassen) oder crop (Zuschneiden)",
            "default": "fit"
          },
          "display": {
            "type": "boolean",
            "title": "Display",
            "description": "Nach dem Upload direkt auf dem Fernseher zeigen",
            "default": false
          },
          "matte": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Matte",
            "description": "Passepartout (none, shadowbox_polar …); Standard aus der Konfiguration"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_image_api_images_post"
      },
      "FileRef": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "mime_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mime Type"
          },
          "download_link": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Download Link"
          }
        },
        "type": "object",
        "title": "FileRef"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "Health"
      },
      "Image": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Lokale Bild-ID (32 Hex-Zeichen)"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "created_at": {
            "type": "string",
            "title": "Created At",
            "description": "Upload-Zeitpunkt, ISO 8601 UTC"
          },
          "width": {
            "type": "integer",
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "title": "Height"
          },
          "source_width": {
            "type": "integer",
            "title": "Source Width"
          },
          "source_height": {
            "type": "integer",
            "title": "Source Height"
          },
          "fit_mode": {
            "type": "string",
            "title": "Fit Mode",
            "description": "fit = Einpassen, crop = Zuschneiden"
          },
          "original_name": {
            "type": "string",
            "title": "Original Name"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "tv_content_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tv Content Id",
            "description": "ID auf dem Fernseher, sobald einmal übertragen"
          },
          "matte": {
            "type": "string",
            "title": "Matte",
            "description": "Passepartout, z. B. none oder shadowbox_polar",
            "default": "none"
          },
          "file_url": {
            "type": "string",
            "title": "File Url"
          },
          "thumbnail_url": {
            "type": "string",
            "title": "Thumbnail Url"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "created_at",
          "width",
          "height",
          "source_width",
          "source_height",
          "fit_mode",
          "original_name",
          "size_bytes",
          "file_url",
          "thumbnail_url"
        ],
        "title": "Image"
      },
      "ImportBody": {
        "properties": {
          "openaiFileIdRefs": {
            "items": {
              "$ref": "#/components/schemas/FileRef"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "Openaifileidrefs",
            "description": "Dateien mit download_link, wie ChatGPT-Aktionen sie senden"
          },
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "default": "fit"
          },
          "display": {
            "type": "boolean",
            "title": "Display",
            "default": true
          },
          "matte": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Matte"
          },
          "passepartout": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Passepartout",
            "description": "true: mit Standard-Passepartout (ai_matte), false: ohne"
          }
        },
        "type": "object",
        "required": [
          "openaiFileIdRefs"
        ],
        "title": "ImportBody"
      },
      "ImportResult": {
        "properties": {
          "images": {
            "items": {
              "$ref": "#/components/schemas/Image"
            },
